{
  "$schema": "https://opencode.ai/config.json",
  // Configure Ruff as your Python Language Server
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    }
  },

  //"model": "google/gemini-3.8-flash",
  "model": "nrp/Qwen3",
  
  // Use Gemini for small, quick tasks as well.
  "small_model": "nrp/gemma-small",

  "provider": {
    "google": {
      "options": {
        "apiKey": "{file:~/.gemini-token}"
      }
    },
    "nrp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NRP LLM",
      "options": {
        "baseURL": "https://ellm.nrp-nautilus.io/v1",
        "apiKey": "{file:~/.nrp-llm-token}"
      },
      "models": {
        "minimax-m2": { "name": "MiniMax M2" },
        "gpt-oss": { "name": "GPT-OSS" },
        "qwen3": { "name": "Qwen3 397B" },
        "gemma-small": { "name": "Gemma 4 12B" },
        "gemma": { "name": "Gemma 31B" }
      }
    }
  },
  "mcp": {
    "uproot": { "type": "remote", "url": "http://127.0.0.1:9101/mcp", "enabled": true },
    "xrootd": { "type": "remote", "url": "http://127.0.0.1:9102/mcp", "enabled": true },
    "rucio": { "type": "remote", "url": "http://127.0.0.1:9103/mcp", "enabled": true }
  }
}
