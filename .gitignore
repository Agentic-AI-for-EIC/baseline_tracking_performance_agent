# Python bytecode - regenerable, never reviewable. (A batch of .pyc files was
# accidentally committed before this file existed; they were untracked with
# `git rm --cached` and must not come back.)
__pycache__/
*.py[cod]
*$py.class

# Linters / typecheckers
.ruff_cache/
.mypy_cache/

# Local run state (pidfiles point at dead container PIDs; logs are huge).
# Note: output/, cache/ and runs/*.log are COMMITTED run artifacts in this
# project, so they are deliberately NOT ignored here.
runs/*.pid
runs/*.start

# Concatenated PID feature tables: too big for GitHub (>100 MB) and fully
# regenerable offline from the tracked per-file cache via
#   python -m pid features --file-list filelists/clean_150.txt --dataset-tag clean --max-file-failures 0 --cache-dir cache/pid_features --out output/pid-features_clean.pkl
#   python -m pid features --file-list filelists/bkg_200.txt --dataset-tag bkg_mixed --max-file-failures 20 --cache-dir cache/pid_features --out output/pid-features_bkg_mixed.pkl
output/pid-features_*.pkl

# Reproduction-pair read caches (26.07.1 gautschi streaming): 28 GB + 95 GB
# of per-file pickles, far past GitHub limits; fully regenerable by rerunning
# scripts/run_reproduction_26071.sh (re-streams from the login00 xrootd tunnel).
cache/clean26071_files/
cache/bkg26071_files/

# Full-sample score tables for the 26.07.1 grid (pooled/clean reach ~90 MB):
# regenerable offline via `python -m pid train --task <t> --model <lib>
# --dataset-tag clean26071|bkg26071 --features output/pid-features_<tag>.pkl`;
# the held-out test_scores.pkl (what every table/figure is computed from) IS
# committed.
output/models/*_clean26071/all_scores.pkl
output/models/*_bkg26071/all_scores.pkl
